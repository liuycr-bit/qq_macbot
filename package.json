{
  "name": "qq-agent-macos",
  "version": "0.3.0-macos.1",
  "private": false,
  "description": "macOS QQ 群 AI 机器人：连接 NapCat OneBot v11，支持 OpenAI 兼容模型与图形控制台。",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "local.qqagent.macos",
    "productName": "QQ Agent Mac",
    "artifactName": "QQ-Agent-Mac-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!data/**",
      "!test/**",
      "!docs/**",
      "!scripts/**",
      "!dist/**",
      "!runtime/**",
      "!release/**",
      "!**/*.map",
      "!package-lock.json.bak",
      "!task_plan.md",
      "!findings.md",
      "!progress.md",
      "!*.log"
    ],
    "asarUnpack": [
      "node_modules/@memecrafters/**/*",
      "src/meme-worker.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "QQ Agent Mac ${version}"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "setup:meme": "node scripts/install-meme-extension.mjs",
    "pack:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "test": "node test/selftest.mjs && node test/render-test.mjs && node test/scroll-test.mjs && node test/usage-e2e.mjs",
    "test:prompt": "node test/test-prompt.mjs",
    "test:render": "node test/render-test.mjs",
    "test:scroll": "node test/scroll-test.mjs",
    "test:usage": "node test/usage-e2e.mjs"
  },
  "dependencies": {
    "@memecrafters/meme-generator": "0.2.3",
    "js-yaml": "^5.4.1",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "author": "Kondius",
  "keywords": [
    "qq",
    "bot",
    "agent",
    "openai",
    "onebot",
    "llm",
    "desktop",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liuycr-bit/mac_qq_bot.git"
  },
  "bugs": {
    "url": "https://github.com/liuycr-bit/mac_qq_bot/issues"
  },
  "homepage": "https://github.com/liuycr-bit/mac_qq_bot#readme",
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": false
  }
}
